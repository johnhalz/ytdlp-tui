<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>ytdlp-tui</id>
    <version>0.1.0</version>
    <title>ytdlp-tui</title>
    <authors>ytdlp-tui contributors</authors>
    <projectUrl>https://github.com/OWNER/yt-dlp-tui</projectUrl>
    <licenseUrl>https://github.com/OWNER/yt-dlp-tui/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Interactive terminal UI for yt-dlp (resolution, format, audio-only, subtitles).</description>
    <summary>Terminal UI for yt-dlp downloads.</summary>
    <releaseNotes>https://github.com/OWNER/yt-dlp-tui/releases</releaseNotes>
    <tags>yt-dlp youtube download cli terminal</tags>
    <docsUrl>https://github.com/OWNER/yt-dlp-tui/blob/main/README.md</docsUrl>
    <bugTrackerUrl>https://github.com/OWNER/yt-dlp-tui/issues</bugTrackerUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
